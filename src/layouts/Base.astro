---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  article?: boolean
  date?: Date
}

const {
  title = '이정재의 엔지니어링 노트',
  description = 'Applied AI Engineer 이정재의 기술 블로그. LLM Ops, AI 제품 개발과 백엔드 설계의 구현 경험을 기록합니다.',
  article = false,
  date,
} = Astro.props
const isNotFound = Astro.url.pathname === '/404/' || Astro.url.pathname === '/404.html'
const canonical = new URL(isNotFound ? '/404.html' : Astro.url.pathname, Astro.site)
const image = new URL('/og.png', Astro.site)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': article ? 'BlogPosting' : 'Blog',
  headline: title,
  description,
  url: canonical.href,
  image: image.href,
  inLanguage: 'ko-KR',
  author: { '@type': 'Person', name: '이정재', url: 'https://www.linkedin.com/in/jerrylee1516/' },
  ...(date ? { datePublished: date.toISOString() } : {}),
}
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{article ? `${title} · 이정재의 엔지니어링 노트` : title}</title>
    <meta name="description" content={description} />
    {isNotFound && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="이정재의 엔지니어링 노트" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="이정재의 엔지니어링 노트" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", String.fromCharCode(92) + "u003c")} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="이정재의 엔지니어링 노트 홈"><span class="brand-dot" />JUNGJAE LEE<span class="wordmark-note"> / NOTES</span></a>
      <nav aria-label="주요 메뉴">
        <a href="/">글 목록</a>
        <a href="/papers/">논문 노트</a>
        <a href="https://jaerrylee.github.io/portfolio/">포트폴리오 <span aria-hidden="true">↗</span></a>
        <a href="/rss.xml" class="rss-link">RSS <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <div><strong>이정재</strong><p>Applied AI Engineer · LLM Ops</p></div>
      <div class="footer-links">
        <a href="https://www.linkedin.com/in/jerrylee1516/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href="https://github.com/JaerryLee" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href="/rss.xml">RSS ↗</a>
      </div>
    </footer>
  </body>
</html>
